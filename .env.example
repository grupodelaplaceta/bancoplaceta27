# Todo esto va en Vercel > Settings > Environment Variables (nunca en el repo)
# Scopes recomendados para la clave: accounts:read accounts:write transactions:read receipts:read
#   cards:read transfers:read transfers:write memberships:read memberships:write products:read
PLACETA_API_KEY=plk_...            # Bancos > Gestionar > Claves de API (necesita accounts:read para buscar por DIP)
PLACETAID_CLIENT_ID=
PLACETAID_CLIENT_SECRET=           # regenéralo si se compartió en algún chat
SESSION_SECRET=                    # cadena aleatoria larga (obligatoria en producción)
APP_URL=https://bancoplaceta27.vercel.app
.
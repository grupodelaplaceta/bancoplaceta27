# Todo esto va en Vercel > Settings > Environment Variables (nunca en el repo)

# --- Placeta One (API v1) ---
PLACETA_BANCO_CLAVE=plk_...         # clave del cliente del banco (permiso sesiones:crear). Mismo cliente que la firma
PLACETA_BANCO_FIRMA=                # secreto de firma de ESE mismo cliente (64 hex, se muestra una vez). Nunca el de PlacetaID
# (Compatibilidad: PLACETA_API_KEY y PLACETA_API_SECRET siguen funcionando si no existen las nuevas.)

# --- PlacetaID (inicio de sesión) ---
PLACETAID_CLIENT_ID=plid27_Sy0iSFTwpkklt8OK
PLACETAID_CLIENT_SECRET=           # secreto de PlacetaID (regenéralo si alguna vez se compartió)
# PLACETAID_DIP_FIELD=dip          # campo del perfil de PlacetaID que contiene el DIP del cliente

# --- App ---
SESSION_SECRET=                    # cadena aleatoria de 32+ caracteres:  openssl rand -base64 32
APP_URL=https://bancoplaceta27.vercel.app

# Opcionales
# SESSION_MINUTES=30               # duración de la sesión bancaria (5–60; la API admite 60 como máximo)
# PLACETA_API_URL=https://placetaone.vercel.app/api/v1   # cambia solo para apuntar al simulador local
# DEV_LOGIN=1                      # acceso de pruebas SOLO en local (se ignora en producción)
# DEV_DIP=12345678Z                # DIP que usa el acceso de pruebas


# --- Pasarela de pago para empresas (la ENTIDAD decide qué pueden configurar) ---
# GATEWAY_CONFIG={"enabled":true,"min":1,"max":5000,"maxMinutes":30,"defaultMinutes":15,"defaultOrigin":"https://app.tubanco.es","requireConcept":true,"allow":{"origen":false,"minutos":true,"concepto":true}}
# GATEWAY_ADMINS=id-placetaid-1,id-placetaid-2   # quién puede solicitar/retirar orígenes autorizados (de la entidad, no de cada empresa)

# Si PlacetaID no devuelve el DIP, la app se lo pide al usuario (una vez). Para evitar que alguien escriba el DIP de otra persona:
# VERIFY_HOLDER=1                  # exige que el titular enmascarado del banco («Ma***») encaje con el nombre de PlacetaID

# --- Operaciones de entidad (solo operadores) ---
# ENTIDAD_CIP=CIP-00000001                # CIP de tu entidad (lo rellena el servidor en cada operación)
# OPERADORES_DIP=12345678Z,87654321X      # DIP de quienes ven la sección «Entidad» (el resto recibe 403)

# NFC (opcional): clave que usa tu terminal/servidor para validar tokens en POST /api/nfc/verify (cabecera x-nfc-key)
NFC_VERIFY_KEY=
